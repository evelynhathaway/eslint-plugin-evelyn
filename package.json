{
  "name": "eslint-plugin-evelyn",
  "version": "11.0.1",
  "description": "ESLint plugin for my projects with my preferred code style and bugfixes",
  "keywords": [
    "eslint",
    "eslint-config",
    "eslint-plugin"
  ],
  "homepage": "https://github.com/evelynhathaway/eslint-plugin-evelyn#readme",
  "bugs": {
    "url": "https://github.com/evelynhathaway/eslint-plugin-evelyn/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evelynhathaway/eslint-plugin-evelyn.git"
  },
  "license": "MIT",
  "author": "Evelyn Hathaway <npm@evelyn.dev> (https://evelyn.dev)",
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./files": "./lib/files.js"
  },
  "main": "./lib/index.js",
  "directories": {
    "lib": "/lib"
  },
  "files": [
    "/lib"
  ],
  "scripts": {
    "lint": "eslint",
    "prepare": "husky"
  },
  "commitlint": {
    "extends": "./node_modules/conventional-changelog-evelyn/commitlint.config.js"
  },
  "lint-staged": {
    "**/package.json": "sort-package-json",
    "./": "eslint --fix"
  },
  "release": {
    "extends": "conventional-changelog-evelyn/release.config.js"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^15.5.4",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.4.0",
    "commitlint": "^20.1.0",
    "conventional-changelog-evelyn": "^2.0.1",
    "eslint": "^9.37.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-n": "^17.23.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-regexp": "^2.10.0",
    "eslint-plugin-testing-library": "^7.13.0",
    "eslint-plugin-unicorn": "^61.0.2",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.3",
    "semantic-release": "^24.2.9",
    "sort-package-json": "^3.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "peerDependencies": {
    "@next/eslint-plugin-next": "^15.0.0",
    "@stylistic/eslint-plugin": "^5.4.0",
    "eslint": "^9.37.0",
    "eslint-import-resolver-typescript": "^4.0.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^29.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-n": "^17.15.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-regexp": "^2.0.0",
    "eslint-plugin-testing-library": "^7.0.0",
    "eslint-plugin-unicorn": "^61.0.0",
    "globals": "^16.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": ">=8.46.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
